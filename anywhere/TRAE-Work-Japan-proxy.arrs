name = TRAE
routing = 0
# TRAE Work / TRAE SOLO strict-isolation routing rules.
# Assign this rule set to a Japan node in Anywhere.
# Shared third-party APIs are deliberately excluded to avoid affecting other apps.
# Anywhere types: 0 IPv4 CIDR, 1 IPv6 CIDR, 2 Domain Suffix, 3 Domain Keyword

