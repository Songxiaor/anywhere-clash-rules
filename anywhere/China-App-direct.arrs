name = 国内应用直连
routing = 1
# Unified DIRECT ruleset for China-first apps on this Mac.
# Source: local app inventory + live path tests (2026-08-04).
# Problem pattern: overseas VPN egress makes CN CDN/API slow or timeout
# (e.g. umiwi -> LAX, voice-input.qianwen.com -> us34).
#
# Included (installed / actively used on this machine):
#   - 得到大脑 Dedao
#   - 千问输入法 Qianwen IME
#   - 微信 WeChat
#   - 飞书 Feishu (CN)
#   - 百度网盘 Baidu Netdisk
#   - WPS / 金山文档
#   - 幕布 Mubu
#   - 网易 UU 远程
#   - 星橙知道 直播回放 (xcknow)
#   - 星橙知道 直播间 (qianyanwy) + 腾讯云直播 CDN (2026-10-05)
#   - 国内 AI 应用：豆包 / Kimi / DeepSeek / MiniMax(国内版)
#
# Intentionally NOT included (need proxy / overseas):
#   - ChatGPT / Claude / Grok / OpenAI / Anthropic / xAI
#   - Telegram / X / Google / YouTube
#   - Lark international (larksuite.com overseas tenants)
#   - Cursor / Codex / ego overseas AI backends
#
# Set this rule set route to 直连 in Anywhere after refresh.
# Anywhere types: 0 IPv4 CIDR, 1 IPv6 CIDR, 2 Domain Suffix, 3 Domain Keyword

