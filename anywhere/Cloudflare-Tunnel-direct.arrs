name = Cloudflare隧道直连
routing = 1
# cloudflared (Cloudflare Tunnel) edge connections go direct.
# Problem: under Anywhere TUN the edge address resolves to 198.18.x.x and the TLS handshake
# is dropped ("TLS handshake with edge error: EOF"), so the tunnel never registers.
# Used for reaching OpenMausBot from a phone through maus.songyichen.ccwu.cc.
# Anywhere types: 0 IPv4 CIDR, 1 IPv6 CIDR, 2 Domain Suffix, 3 Domain Keyword

2, argotunnel.com
2, cloudflare.com
2, trycloudflare.com
# Cloudflare edge IPv4 ranges (tunnel connects by IP, domain rules alone do not match)
0, 198.41.128.0/17
0, 162.159.0.0/16
0, 162.158.0.0/15
0, 172.64.0.0/13
0, 104.16.0.0/13
0, 108.162.192.0/18
0, 141.101.64.0/18
0, 173.245.48.0/20
0, 188.114.96.0/20
0, 190.93.240.0/20
0, 197.234.240.0/22
0, 103.21.244.0/22
0, 103.22.200.0/22
0, 103.31.4.0/22
0, 131.0.72.0/22
